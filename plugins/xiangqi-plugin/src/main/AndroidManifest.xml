<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto.js 插件 APK：没有界面，宿主通过 <meta-data> 里的注册类反射加载。

  ⚠️ org.autojs.plugin.sdk.registry 是 Auto.js 插件 SDK 约定的键名，
  官方 Auto.js Pro 与本仓库（AI.js Pro）都按它找注册类，所以这个插件两边都能装。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="象棋引擎插件"
        android:hasCode="true">

        <meta-data
            android:name="org.autojs.plugin.sdk.registry"
            android:value="com.jdkshen.xiangqi.plugin.PluginRegistry" />
    </application>

</manifest>
