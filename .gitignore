# IDE and operating-system metadata
*.iml
.DS_Store
/.idea/
**/.idea/

# Local machine configuration
/local.properties
/.vscode/settings.json
/tools/*
!/tools/test-miuix.ps1
!/tools/compare-engine-api.ps1
!/tools/measure-ui-performance.ps1
!/tools/jdk17.ps1
# dev-update.ps1 是 AGENTS.md 指定的日常出包入口，此前被 /tools/* 静默忽略，
# 导致对它的修改（如多设备 -DeviceId 修复）无法提交且没有任何提示。
!/tools/dev-update.ps1
# publish.ps1 是推荐的发布入口（前置校验 + 发布后验证 + 自动日志 + -DryRun）；
# 它原先只存在于被忽略的 .artifacts/ 下，永远无法入库。
!/tools/publish.ps1
!/tools/serve-updates.ps1
!/tools/probe-engine-api.ps1
!/tools/test-engine-flavors-device.ps1
!/tools/observe-filelist.ps1

# CodeGraph local index (regenerate with `codegraph init`)
/.codegraph/

# Gradle and native build caches
/.gradle/
/build/
**/build/
/**/.kotlin/
**/.gradle/
**/.externalNativeBuild/
**/.cxx/
# These are real source directories named "build" (Java packages), not build outputs.
!apps/app/src/main/java/com/jdkshen/aijspro/build/
!apps/app/src/main/java/com/jdkshen/aijspro/build/**
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/**
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/**

# Generated release and capture directories
/release/
/captures/

# Local diagnostics and archived deliverables
/.artifacts/
/.codex-artifacts/
/*.png
/*.mp4
/*.log
/build-*.txt
/_apk_so_check.so
/f_back
/f_scrim

# Generated binaries
*.apk
*.exe

# Required source input for the in-app APK builder.
!apps/app/src/main/assets/template.apk
