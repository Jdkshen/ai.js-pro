# IDE and operating-system metadata
*.iml
.DS_Store
/.idea/
**/.idea/

# Local machine configuration
/local.properties
/.vscode/settings.json
/tools/*
# Reviewed five-item optimization helpers (keep unrelated local tools ignored).
!/tools/tests/
/tools/tests/*
!/tools/tests/test_m3_lazy_setup.py
!/tools/tests/test_apk_size_audit.py
!/tools/tests/test_mcp_probe_behavior.py
!/tools/audit-apk-size.py
!/tools/flutter-poc/
/tools/flutter-poc/*
!/tools/flutter-poc/build-release-candidate.ps1
!/tools/ace-android-touch.js
!/tools/vendor-ace-editor.py
!/tools/test-ace-language.cjs
!/tools/test-miuix.ps1
!/tools/compare-engine-api.ps1
!/tools/measure-ui-performance.ps1
!/tools/jdk17.ps1
# dev-update.ps1 是 AGENTS.md 指定的日常出包入口，此前被 /tools/* 静默忽略，
# 导致对它的修改（如多设备 -DeviceId 修复）无法提交且没有任何提示。
!/tools/dev-update.ps1
# publish.ps1 是推荐的发布入口（前置校验 + 发布后验证 + 自动日志 + -DryRun）；
# 它原先只存在于被忽略的 .artifacts/ 下，永远无法入库。
!/tools/publish.ps1
!/tools/serve-updates.ps1
!/tools/probe-engine-api.ps1
# 16 KB 页对齐守卫（P0）：gradle verify16kbAlignment / 发布前置校验共用的静态检查脚本。
!/tools/verify-16kb-alignment.ps1
# 原生库 strip 守卫（task-145）：检查 AAR/APK 里没有未 strip 的 .so、R8 API 数据库资源被排除。
!/tools/verify-native-strip.ps1
# OpenCV AAR strip 工具（task-145）：重生成 AAR 后跑一次，去掉 native 调试符号。
!/tools/strip-opencv-aar.ps1
# Pro ws-rpc 协议核心的 javac + JUnit 自测（不跑 Gradle、不连设备；见脚本头部说明）。
!/tools/test-pro-rpc.ps1
!/tools/test-engine-flavors-device.ps1
# Node 示例真机回归工具（task-216）：自动发现/push/运行/判定 Node 示例，结果写 output/。
!/tools/test-node-samples-device.ps1
!/tools/verify-mcp-alignment-device.py
!/tools/floaty-stop-regression.py
!/tools/create-gh-proxy-manifest.py
!/tools/observe-filelist.ps1
# Reproducible SIFT/chess device evaluation sources.
!/tools/prepare-sift-chess-fixtures.py
!/tools/test-sift-chess-device.js
!/tools/sift-chess-pipeline.js
!/tools/test-sift-chess-pipeline-device.js
!/tools/xiangqi-release.py
!/tools/imgui-font-subset.py
# Gradle 构建直接调用的生成脚本（prepareXiangqiRelease / verifyImGuiFontSubset）：
# 曾被 /tools/* 静默忽略，导致全新 clone 与 CI 在第一个 gradle 任务就失败。

# CodeGraph local index (regenerate with `codegraph init`)
/.codegraph/

# Gradle and native build caches
/.gradle/
/build/
**/build/
/**/.kotlin/
**/.gradle/
**/.externalNativeBuild/
**/.cxx/
# These are real source directories named "build" (Java packages), not build outputs.
!apps/app/src/main/java/com/jdkshen/aijspro/build/
!apps/app/src/main/java/com/jdkshen/aijspro/build/**
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/**
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/**

# Generated release and capture directories
/release/
/captures/

# 本地大体积产物 / 误生成目录（不属于源码，不随仓库分发）
# None/ = 某次 ai 工具在错误 cwd 下生成的缓存；org/ = javac 编译的 .class；META-INF/ = zip 工具残留
/None/
/META-INF/
/org/
/output/
/runs/
/bench.raw
/yolo26s.pt
/chess-preview/
__pycache__/

# Local diagnostics and archived deliverables
/.artifacts/
/.codex-artifacts/
/*.png
/*.mp4
/*.log
/build-*.txt
/_apk_so_check.so
/f_back
/f_scrim

# vscode-extension 的 npm 安装日志（根目录 /*.log 只挡根目录，这条覆盖子目录）
npm-install.log

# Generated binaries
*.apk
*.exe

# Required source input for the in-app APK builder (now shipped by the apkbuilder plugin).
!plugins/apkbuilder-plugin/src/main/assets/template.apk
# 主 APK 内置的瘦身打包模板（verifySlimPackagingTemplate / 打包页运行时需要）：
# 仍属生成物，但必须入库（约 16.6MB，走 LFS），否则全新 clone/CI 缺失会让构建失败。
!/apps/app/src/main/assets/template.apk
javac.*.args

# Flutter 工程本地缓存（flutter-ui 是源码目录，不提交 .dart_tool/build）
flutter-ui/.dart_tool/
flutter-ui/build/
flutter-payload-base/.dart_tool/
