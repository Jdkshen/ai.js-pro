# IDE and operating-system metadata
*.iml
.DS_Store
/.idea/
**/.idea/

# Local machine configuration
/local.properties
/.vscode/settings.json

# ---------------------------------------------------------------------------
# tools/ 的跟踪策略（2026-11-06 整理规范时改正）
#
# 旧策略是「先生成 /tools/* 全部忽略，再逐个 ! 白名单」。后果：44 个真实脚本
# （device 驱动、引擎审计、Node24 契约测试、probes…）被**静默忽略**、无法入库，
# 而且每次新增脚本都会再踩一次（AGENTS.md 里已两次记录同一个坑）。
# 现在改为：**tools/ 下默认全部跟踪**，只忽略缓存与本地专用目录。
# 新增脚本不再需要改 .gitignore。
# ---------------------------------------------------------------------------
/tools/**/__pycache__/
/tools/**/*.pyc
/tools/templates/
# 打包试验目录：只入库发布脚本，产物与临时树忽略。
/tools/flutter-poc/*
!/tools/flutter-poc/build-release-candidate.ps1
/tools/apk-audit/*
!/tools/apk-audit/CheckRetrofitSignatures.java
/tools/apktool-android/build/
/tools/apktool-android/dist/
/tools/reverse-native/r2ghidra-build/
/tools/apk-components/.gradle/
# CodeGraph local index (regenerate with `codegraph init`)
/.codegraph/

# Gradle and native build caches
/.gradle/
/build/
**/build/
/**/.kotlin/
**/.gradle/
**/.externalNativeBuild/
**/.cxx/
# These are real source directories named "build" (Java packages), not build outputs.
!apps/app/src/main/java/com/jdkshen/aijspro/build/
!apps/app/src/main/java/com/jdkshen/aijspro/build/**
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/main/java/com/jdkshen/aijspro/autojs/build/**
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/testMiuix/java/com/jdkshen/aijspro/autojs/build/**
!apps/app/src/test/java/com/jdkshen/aijspro/autojs/build/
!apps/app/src/test/java/com/jdkshen/aijspro/autojs/build/**

# Generated release and capture directories
/release/
/captures/

# 本地大体积产物 / 误生成目录（不属于源码，不随仓库分发）
# None/ = 某次 ai 工具在错误 cwd 下生成的缓存；org/ = javac 编译的 .class；META-INF/ = zip 工具残留
/None/
/META-INF/
/org/
/output/
/runs/
/bench.raw
/yolo26s.pt
/chess-preview/
__pycache__/

# Local diagnostics and archived deliverables
/.artifacts/
/.codex-artifacts/
/*.png
/*.mp4
/*.log
/build-*.txt
/_apk_so_check.so
/f_back
/f_scrim

# vscode-extension 的 npm 安装日志（根目录 /*.log 只挡根目录，这条覆盖子目录）
npm-install.log

# Generated binaries
*.apk
*.exe

# Required source input for the in-app APK builder (now shipped by the apkbuilder plugin).
!plugins/apkbuilder-plugin/src/main/assets/template.apk
# 主 APK 内置的瘦身打包模板（verifySlimPackagingTemplate / 打包页运行时需要）：
# 仍属生成物，但必须入库（约 16.6MB，走 LFS），否则全新 clone/CI 缺失会让构建失败。
!/apps/app/src/main/assets/template.apk
javac.*.args

# Flutter 工程本地缓存（flutter-ui 是源码目录，不提交 .dart_tool/build）
flutter-ui/.dart_tool/
flutter-ui/build/
flutter-payload-base/.dart_tool/
