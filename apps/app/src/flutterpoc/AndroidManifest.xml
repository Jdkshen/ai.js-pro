<?xml version="1.0" encoding="utf-8"?>
<!-- Flutter 玻璃界面 POC：只在 -PflutterPoc=true 时由 app/build.gradle 挂进 debug 变体。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- 主入口：SplashActivity 依据 R.bool.flutter_main_entry 跳到本 Activity。 -->
        <activity
            android:name="com.jdkshen.aijspro.flutterpoc.GlassFlutterActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AiJsPro.GlassFlutter"
            android:windowSoftInputMode="adjustResize"/>

        <!-- 主入口默认解析优先级：有两个 LAUNCHER 时让系统（安装器「打开」、通知等
             getLaunchIntentForPackage 调用）优先解析到 Splash -> Flutter。 -->
        <activity android:name=".ui.splash.SplashActivity">
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- task-177：Miuix 回退入口已删除，桌面只剩 Flutter 玻璃界面一个图标（Splash → 本 Activity）。 -->

        <!-- Phase0：脚本执行的隔离进程。主进程（PocNativeRunner）通过 bindService + Messenger
             驱动它，在 :native 进程内 headless 执行需要原生库的脚本，不依赖任何 Activity。 -->
        <service
            android:name="com.jdkshen.aijspro.flutterpoc.nativeproc.NativeScriptService"
            android:exported="false"
            android:process=":native"/>

        <!-- Phase1：所有脚本的通用隔离执行进程。主进程（PocScriptHost）通过 bindService + Messenger
             驱动它；Phase0 的 :native 保留为回退路径，两个服务各自一个进程、互不踩踏。 -->
        <service
            android:name="com.jdkshen.aijspro.flutterpoc.scriptproc.ScriptHostService"
            android:exported="false"
            android:process=":script"/>

        <!-- Phase1 P1：主进程自动化代理。:script 通过 IAutomationHost（AIDL）把无障碍节点查询 /
             点击 / 手势 / 全局动作 / 截图代理回主进程执行；服务不声明 android:process（即主进程），
             exported=false + 调用方 uid 校验，只允许同 uid 的 :script 绑定。 -->
        <service
            android:name="com.jdkshen.aijspro.automation.AutomationHostService"
            android:exported="false"/>
        <!-- 仅 POC/调试：adb 广播触发脚本运行/停止/AUTO 门控，便于真机回归（正式构建不含本变体）。 -->
        <receiver
            android:name="com.jdkshen.aijspro.flutterpoc.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jdkshen.aijspro.flutterpoc.DEBUG_RUN"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>