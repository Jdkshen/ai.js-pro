  "apk_edit_text": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "editSessionId": {
        "type": "string"
      },
      "locator": {
        "type": "string"
      },
      "targetVersion": {
        "type": "string",
        "description": "读取结果返回的内容 SHA-256。新建目标可用 missing，并配合单个 write_target；旧版本会报内容已改变，应重新读取。"
      },
      "edits": {
        "type": "array",
        "description": "1..200 个编辑；同一批基于一个不可变的 LF 归一化原文，匹配文本必须唯一。普通文本保留原行尾（CRLF/CR/LF），DEX/AXML 走编译。",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "write_target",
                "replace_match",
                "insert_before_match",
                "insert_after_match"
              ]
            },
            "matchText": {
              "type": "string"
            },
            "writeText": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "matchText",
            "writeText"
          ]
        }
      }
    },
    "required": [
      "workspaceId",
      "editSessionId",
      "locator",
      "targetVersion",
      "edits"
    ]
  },
