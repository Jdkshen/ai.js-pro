{
  "apk_workspace_open": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "description": "工具目录内的 APK 路径；已有 APK 上下文用 aijs://current-apk 取回（没有上下文时先按实际路径打开）；已保存工作区用 aijs://workspace/<workspaceId> 且 temporary=false。公开写法只使用 aijs://，旧 URI 仅作输入兼容。"
      },
      "temporary": {
        "type": "boolean",
        "description": "true 为一次性临时工作区；打开已保存工作区必须为 false。"
      }
    },
    "required": [
      "path",
      "temporary"
    ]
  },
  "apk_list_available_apks": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prefix": {
        "type": "string"
      },
      "limit": {
        "type": "integer"
      }
    },
    "required": [
      "prefix",
      "limit"
    ]
  },
  "apk_workspace_list": {
    "type": "object",
    "additionalProperties": false,
    "properties": {},
    "required": []
  },
  "apk_list": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "editSessionId": {
        "type": "string"
      },
      "view": {
        "type": "string",
        "enum": [
          "zip_entries",
          "dex_classes",
          "resource_table"
        ]
      },
      "prefix": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "description": "本页最多1000项，后续用apk_continue；最大值见返回pagination.limitMax。"
      }
    },
    "required": [
      "workspaceId",
      "editSessionId",
      "view",
      "prefix",
      "limit"
    ]
  },
  "apk_search": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "editSessionId": {
        "type": "string"
      },
      "target": {
        "type": "string",
        "description": "搜索范围。overview 覆盖 ZIP 路径、AXML 文本、资源名/值和 DEX（类/字段/方法/字符串）；资源文件路径用 resource_table_file_paths，native 用 native_symbols/native_strings；files 搜索 ZIP 路径及解码后的 AXML；smali 只支持 contains。",
        "enum": [
          "overview",
          "files",
          "resource_table_names",
          "resource_table_values",
          "resource_table_file_paths",
          "dex_names",
          "dex_strings",
          "dex_string_members",
          "smali",
          "native_symbols",
          "native_strings"
        ]
      },
      "query": {
        "type": "string",
        "maxLength": 16384
      },
      "queryType": {
        "type": "string",
        "description": "regex 使用 Java java.util.regex（支持环视/反向引用），受时间/字符访问预算限制。",
        "enum": [
          "literal",
          "regex"
        ]
      },
      "caseSensitive": {
        "type": "boolean",
        "description": "false 时使用 Unicode 不区分大小写匹配。"
      },
      "matchMode": {
        "type": "string",
        "description": "contains 为子串/正则查找；exact 要求整个候选文本匹配。smali 不支持 exact。",
        "enum": [
          "contains",
          "exact"
        ]
      },
      "prefix": {
        "type": "string",
        "description": "按目标类型过滤候选：DEX 可用 Java 包名或 JVM 描述符，资源可用 type/name 或 0x ID，ZIP/native 用路径前缀；overview 的 prefix 必须为空。"
      },
      "includeMatchOffsets": {
        "type": "boolean",
        "description": "true 时返回 matchOffsets.start/end（Java UTF-16 偏移，不是码点）和 matchOffset。"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "snippetMaxChars": {
        "type": "integer",
        "description": "匹配预览的最大码点数；0 表示不返回 snippet。",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "required": [
      "workspaceId",
      "editSessionId",
      "target",
      "query",
      "queryType",
      "caseSensitive",
      "matchMode",
      "prefix",
      "includeMatchOffsets",
      "limit",
      "snippetMaxChars"
    ]
  },
