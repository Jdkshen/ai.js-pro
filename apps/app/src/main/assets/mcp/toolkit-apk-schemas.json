        "enum": [
          "auto",
          "arm",
          "thumb"
        ]
      },
      "expectedHex": {
        "type": "string",
        "description": "当前字节的大写/小写十六进制；必须匹配，最多 256 字节。",
        "maxLength": 512
      },
      "replacementAssembly": {
        "type": "string",
        "description": "汇编指令/标签/.inst。内置汇编器只覆盖 AArch64 常见指令；ARM/Thumb/x86/x86-64 或内置未覆盖形式需要可选 clang（aijs-toolchain install cpp）。结果不得超过 expectedHex 窗口。",
        "maxLength": 4096
      },
      "paddingMode": {
        "type": "string",
        "description": "none 要求汇编结果与窗口等长；nop 用对应架构的 NOP 填充剩余字节。",
        "enum": [
          "none",
          "nop"
        ]
      }
