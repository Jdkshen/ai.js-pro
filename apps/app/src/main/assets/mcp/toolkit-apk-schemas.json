  "apk_resource_read": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceId": {
        "type": "string"
      },
      "editSessionId": {
        "type": "string"
      },
      "reads": {
        "type": "array",
        "description": "1..200 个独立读取；一项失败不会丢弃同批其他结果。",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locator": {
              "type": "string"
            },
            "variant": {
              "type": "string",
              "description": "空字符串或 default 表示默认配置；否则必须精确匹配资源配置名。"
            }
          },
          "required": [
            "locator",
            "variant"
          ]
        }
      },
      "maxValueChars": {
        "type": "integer",
        "description": "value 的最大码点数，超出后截断并标记 valueTruncated。",
        "default": 4096,
        "minimum": 1,
        "maximum": 32768
      },
      "maxValueXmlChars": {
        "type": "integer",
        "description": "valueXml 的最大字符数；超出时不返回 XML（null），并标记 valueXmlTruncated，不能写回半截 XML。整批结果另受 8MiB 预算。",
        "default": 32768,
        "minimum": 1,
        "maximum": 1048576
      },
      "maxItemsPerValue": {
        "type": "integer",
        "description": "复杂资源最多返回的子项数；0 只返回 itemCount/itemsTruncated。",
        "default": 50,
        "minimum": 0,
        "maximum": 2000
      },
      "resolveDepth": {
        "type": "integer",
        "description": "0 不解析引用；1 只解析一级直接引用（优先同配置，其次默认配置），不递归。",
        "default": 0,
        "minimum": 0,
        "maximum": 1
      }
    },
    "required": [
      "workspaceId",
      "editSessionId",
      "reads",
      "maxValueChars",
      "maxValueXmlChars",
      "maxItemsPerValue",
      "resolveDepth"
    ]
  },
