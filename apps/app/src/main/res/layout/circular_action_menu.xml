<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮环形菜单（点悬浮球展开的那一圈按钮）。

  Miuix 化（2026-09-17）：原来五个球是写死的饱和色（@color/colorPrimary / #ef5350 / #42a5f5 / #fdd835 / #C0C0C0），
  深色模式下刺眼、观感也和 Miuix 页面的圆钮不一致。现在统一到「主色 + 危险色」两个语义：
    · 运行脚本 / 布局分析 / 设置 = primary 实心 + onPrimary 图标
    · 录制（状态切换）= error 实心 + onError 图标
    · 停止全部（危险动作）= 红色实心圈 + 白色图标，便于在任意背景上识别
  第二轮（同日）：上一版把后三项做成了 colorSurfaceContainerHigh 的**近白圆**，真机看着「太白、发虚」，
  所以改成主色实心/空心两者，不再有大片白色。
  图标本身都是白色位图（ic_menu 是深灰），所以**必须**逐个写 tint，否则白图标压在浅色底上会看不见。
-->
<com.jdkshen.aijspro.ui.floating.CircularActionMenu xmlns:android="http://schemas.android.com/apk/res/android"
                                                            xmlns:app="http://schemas.android.com/apk/res-auto"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="wrap_content"
                                                            android:clickable="false"
                                                            app:cam_angle="165"
                                                            app:cam_radius="80dp">

    <!--
      尺寸 48dp = 推荐的最小可点区（原来 42dp，真机反馈「点起来不跟手」）；
      视觉圆仍然是 42dp —— 靠 drawable 里的 <inset> 3dp 收进去，反馈改由 background 自带的 ripple 提供。
      图标内容大小不变：48 - 2×11 = 26dp，与原来 42 - 2×8 一致。
    -->
    <ImageView
        android:id="@+id/script_list"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_primary"
        android:padding="11dp"
        android:src="@drawable/ic_menu"
        app:tint="?attr/colorOnPrimary"/>

    <ImageView
        android:id="@+id/record"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_danger"
        android:padding="11dp"
        android:src="@drawable/ic_ali_record"
        app:tint="?attr/colorOnError"/>

    <ImageView
        android:id="@+id/layout_inspect"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_primary"
        android:padding="11dp"
        android:src="@drawable/ic_circular_menu_bounds"
        app:tint="?attr/colorOnPrimary"/>

    <ImageView
        android:id="@+id/stop_all_scripts"
        android:contentDescription="停止全部脚本"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_stop"
        android:padding="11dp"
        android:src="@drawable/ic_close_white_48dp"
        android:tint="@android:color/white"/>


    <ImageView
        android:id="@+id/settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_primary"
        android:padding="11dp"
        android:src="@drawable/ic_circular_menu_settings"
        app:tint="?attr/colorOnPrimary"/>


</com.jdkshen.aijspro.ui.floating.CircularActionMenu>
