<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮环形菜单（点悬浮球展开的那一圈按钮）。

  Miuix 化（2026-09-17）：原来五个球是写死的饱和色（@color/colorPrimary / #ef5350 / #42a5f5 / #fdd835 / #C0C0C0），
  深色模式下刺眼、观感也和 Miuix 页面的圆钮不一致。这里机制不变（仍是 CircularActionMenu 的弧形展开动画），
  只把**底色与图标色**换成主题语义色：
    · 主操作（运行脚本）= primary 底 + onPrimary 图标
    · 危险（录制）      = error 底 + onError 图标
    · 其余              = 中性表面底 + 语义图标色（停止=error，其余=onSurfaceVariant）
  图标本身都是白色位图（ic_menu 是深灰），所以**必须**逐个写 tint，否则白图标压在浅色底上会看不见。
-->
<com.jdkshen.aijspro.ui.floating.CircularActionMenu xmlns:android="http://schemas.android.com/apk/res/android"
                                                            xmlns:app="http://schemas.android.com/apk/res-auto"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="wrap_content"
                                                            android:clickable="false"
                                                            app:cam_angle="165"
                                                            app:cam_radius="80dp">

    <ImageView
        android:id="@+id/script_list"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_primary"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_menu"
        app:tint="?attr/colorOnPrimary"/>

    <ImageView
        android:id="@+id/record"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_danger"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_ali_record"
        app:tint="?attr/colorOnError"/>

    <ImageView
        android:id="@+id/layout_inspect"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_neutral"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_circular_menu_bounds"
        app:tint="?attr/colorOnSurfaceVariant"/>

    <ImageView
        android:id="@+id/stop_all_scripts"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_neutral"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_close_white_48dp"
        app:tint="?attr/colorError"/>


    <ImageView
        android:id="@+id/settings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:background="@drawable/circular_menu_item_neutral"
        android:foreground="?selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_circular_menu_settings"
        app:tint="?attr/colorOnSurfaceVariant"/>


</com.jdkshen.aijspro.ui.floating.CircularActionMenu>