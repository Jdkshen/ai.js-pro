<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮球底盘：**故意保持浅色**（不跟随深色模式），但不要纯白 —— 纯白在深色/花背景上很刺眼，
  真机反馈「白的地方太白」。所以用一块柔和的浅灰蓝底盘 + 更大的圆角 + 一圈几乎看不见的描边。
  球上放的是 `ai_js_pro_float_logo.png`（本身是深色圆角方块图标），底盘不能变暗，否则球会糊在深色背景里。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2F4F8" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#14000000" />
</shape>
