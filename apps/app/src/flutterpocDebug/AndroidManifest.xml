<?xml version="1.0" encoding="utf-8"?>
<!-- Debug commands are never declared in the shared release manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.jdkshen.aijspro.flutterpoc.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.jdkshen.aijspro.flutterpoc.DEBUG_RUN"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
