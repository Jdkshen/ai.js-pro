<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="64dp"
        app:menu="@menu/selection_menu"/>
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/rail" android:layout_width="96dp" android:layout_height="260dp"
        app:menu="@menu/selection_menu"/>
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp"
        app:menu="@menu/selection_menu"/>
</LinearLayout>
