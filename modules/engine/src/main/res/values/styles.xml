<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ConsoleTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorButtonNormal">#cc181818</item>
    </style>

    <style name="ScriptTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:popupTheme" tools:ignore="NewApi">@style/ScriptTheme.PopupOverlay</item>
        <!-- 状态栏颜色必须显式写：AppCompat 主题不带 android:statusBarColor，平台会退回纯黑。
             脚本页跟随主题 attr/colorPrimary（默认青绿），与工具栏同色，并自动包含夜间/主题定制；
             不再跟 Miuix 宿主页面（浅 #F7F7F7 / 深黑）绑定，也不写死具体色值。 -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">@bool/script_light_status_bar</item>
    </style>

    <style name="ScriptTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <style name="ScriptTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>


    <!-- Node UI 的透明主题：不 floating（Activity 仍是全屏窗口），但 windowBackground 透明，
         这样脚本的 ui 根视图下面能透出宿主 App 的内容（液态玻璃「透」的前提）。
         起因：NodeUiLocalActivity$Slot1/2/3 原来用 Theme.Material3.DayNight.NoActionBar（实色背景）
         ⇒ 脚本把宿主 App 整屏盖住，玻璃再怎么调也透不出来（像素实测：栏上方被涂成 [3,3,3]）。 -->
    <style name="ScriptTheme.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="ScriptTheme.Transparent" parent="ScriptTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <color name="colorPrimary">#009688</color>
    <color name="colorPrimaryDark">#009688</color>
    <color name="colorAccent">#03a9f4</color>

    <!-- 兼容旧引用：状态栏颜色跟随主题 colorPrimary；默认使用白色系统图标。 -->
    <color name="script_status_bar">@color/colorPrimary</color>
    <bool name="script_light_status_bar">false</bool>
</resources>