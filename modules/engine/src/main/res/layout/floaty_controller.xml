<?xml version="1.0" encoding="utf-8"?>
<!-- PDF §2.12：engines.startFloatingController 的悬浮控制器（启动/停止、日志、关闭） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controller_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#E6212124"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/controller_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxWidth="220dp"
        android:singleLine="true"
        android:text="脚本"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/controller_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="64dp"
            android:text="启动"
            android:textSize="12sp" />

        <Button
            android:id="@+id/controller_log"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:minWidth="56dp"
            android:text="日志"
            android:textSize="12sp" />

        <Button
            android:id="@+id/controller_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:minWidth="56dp"
            android:text="关闭"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
