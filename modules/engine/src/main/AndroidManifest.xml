<manifest xmlns:android="http://schemas.android.com/apk/res/android"

          package="com.stardust.autojs"
    >

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>

    <application
        >
        <provider android:name="com.jdkshen.aijspro.automation.AutomationStateProvider"
            android:authorities="${applicationId}.automation.state" android:process=":script" android:exported="false"/>
        <service android:name="com.jdkshen.aijspro.automation.AutomationHostService"
            android:process=":script" android:exported="false"/>
        <provider
            android:name="org.autojs.source.engine.android.Node24StorageProvider"
            android:authorities="${applicationId}.node24.storage"
            android:exported="false"/>
        <activity
            android:name=".execution.ScriptExecuteActivity"
            android:process=":script"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/ScriptTheme"/>
        <activity android:name=".execution.MainScriptExecuteActivity"
            android:exported="false" android:configChanges="keyboardHidden|orientation|screenSize"
            android:theme="@style/ScriptTheme"/>
        <activity android:name=".execution.NativeScriptExecuteActivity"
            android:exported="false" android:process=":native"
            android:configChanges="keyboardHidden|orientation|screenSize" android:theme="@style/ScriptTheme"/>
        <service android:name="com.stardust.enhancedfloaty.FloatyService" android:process=":script" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Host" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Native" android:process=":native" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Inspector" android:process=":inspector" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Node" android:process=":node24" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Node1" android:process=":node24_1" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Node2" android:process=":node24_2" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$Node3" android:process=":node24_3" android:exported="false"/>
        <service android:name=".core.floaty.RuntimeFloatyService$NodeUi" android:process=":nodeui" android:exported="false"/>


        <activity
            android:name="com.stardust.autojs.core.permission.PermissionRequestActivity"
            android:excludeFromRecents="true"
            android:taskAffinity="com.stardust.autojs.runtime.api.image.ScreenCaptureRequestActivity"
            android:theme="@style/ScriptTheme.Transparent"/>

        <activity
            android:name="com.stardust.autojs.core.image.capture.ScreenCaptureRequestActivity"
            android:process=":script"
            android:excludeFromRecents="true"
            android:theme="@style/ScriptTheme.Transparent"/>

        <activity
            android:name="com.stardust.autojs.core.image.capture.AutoCapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/ScriptTheme.Transparent"/>

        <!-- Node24 投屏授权页：必须和 Node24Service 同进程，结果回调才在本进程内闭环。
             targetSdk=28，无需前台服务类型；页面非导出、无历史记录，只接受 job-scoped token。 -->
        <activity
            android:name="org.autojs.source.engine.android.Node24CaptureConsentActivity"
            android:process=":node24"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/ScriptTheme.Transparent"/>
        <activity
            android:name="org.autojs.source.engine.android.Node24CaptureConsentActivity3"
            android:process=":node24_3"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/ScriptTheme.Transparent"/>
        <activity
            android:name="org.autojs.source.engine.android.Node24CaptureConsentActivity2"
            android:process=":node24_2"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/ScriptTheme.Transparent"/>
        <activity
            android:name="org.autojs.source.engine.android.Node24CaptureConsentActivity1"
            android:process=":node24_1"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/ScriptTheme.Transparent"/>

        <!-- :node24 进程没有无障碍服务实例，截图授权自动点击由主进程代持（见 CaptureConsentBridge）。 -->
        <receiver
            android:name="org.autojs.source.engine.android.CaptureAutoConsentReceiver"
            android:process=":script"
            android:exported="false">
            <intent-filter>
                <action android:name="org.autojs.source.engine.CAPTURE_AUTO_CONSENT"/>
            </intent-filter>
        </receiver>

        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:process=":script"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

    </application>

</manifest>
