* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Preserve vendored Ace bytes and dependency checksums across platforms.
apps/app/src/main/assets/editor/ace/** -text

# Preserve the upstream Node/ICU license verbatim, including its original indentation.
modules/engine/src/main/assets/node24/tools/NODE-LICENSE.txt -text -whitespace

# Large binary dependencies and runtime assets
*.aar filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
apps/app/src/main/assets/template.apk filter=lfs diff=lfs merge=lfs -text
plugins/apkbuilder-plugin/src/main/assets/template.apk filter=lfs diff=lfs merge=lfs -text
flutter-payload-base/flutter_embedding_3.3.4.jar filter=lfs diff=lfs merge=lfs -text
flutter-payload-base/flutter_embedding_release.jar filter=lfs diff=lfs merge=lfs -text
# Preserve upstream Flutter notices verbatim.
flutter-payload-base/LICENSE -text -whitespace
flutter-payload-base/license.flutter_jar_zip.md -text -whitespace
